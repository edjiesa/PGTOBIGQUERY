# PostgreSQL 10.4 Connection Settings
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=postgres
PG_SCHEMA=public

# Google Cloud BigQuery Settings
GCP_PROJECT_ID=your-gcp-project-id
BIGQUERY_DATASET_ID=your_bigquery_dataset
GCP_CREDENTIALS_FILE=./gcp-service-account.json
# Optional: raw JSON string of Service Account credentials
# GCP_SA_KEY_JSON=

# Migration Engine Settings
BATCH_SIZE=50000
WRITE_DISPOSITION=WRITE_TRUNCATE
AUTO_CREATE_TABLES=true
USE_PARQUET=true
LOG_LEVEL=INFO

# Web UI Server Settings
WEB_HOST=0.0.0.0
WEB_PORT=8000
